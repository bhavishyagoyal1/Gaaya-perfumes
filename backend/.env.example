# ============================================================
# GAAYA PERFUMES — Environment Configuration
# Copy this file to .env and fill in your real values
# NEVER commit .env to Git — it contains secrets!
# ============================================================

# ── Server ──
NODE_ENV=production
PORT=3000

# ── MongoDB (production) ──
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/gaaya

# ── Email (Gmail App Password) ──
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_TO=recipient@example.com
EMAIL_FROM_NAME=Gaaya Perfumes Website

# ── Security (REQUIRED — server will not start without these) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=paste_a_128_char_hex_string_here
ADMIN_KEY=paste_a_64_char_hex_string_here

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CONTACT_RATE_LIMIT_MAX=5

# ── Database ──
DB_PATH=./data/gaaya.db

# ── Logging ──
LOG_LEVEL=info
LOG_DIR=./logs

# ── CORS (comma separated — update before going live!) ──
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
