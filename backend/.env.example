# ============================================================
# GAAYA PERFUMES — Environment Configuration
# Copy this file to .env and fill in your real values
# NEVER commit .env to Git — it contains secrets!
# ============================================================

# ── Server ──
NODE_ENV=production
PORT=3000

# ── Email (Gmail App Password) ──
EMAIL_USER=hackerxag8135@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_TO=bhavishyagoyal54@gmail.com
EMAIL_FROM_NAME=Gaaya Perfumes Website

# ── Security ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_long_random_string_here
ADMIN_KEY=generate_another_secret_here

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CONTACT_RATE_LIMIT_MAX=5

# ── Database ──
DB_PATH=./data/gaaya.db

# ── Logging ──
LOG_LEVEL=info
LOG_DIR=./logs

# ── CORS — comma separated allowed origins ──
ALLOWED_ORIGINS=https://gaayaperfumes.com,https://www.gaayaperfumes.com
